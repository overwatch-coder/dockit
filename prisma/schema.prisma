// Prisma schema for the Shopify product-management dashboard.
// See context/architecture.md (Storage Model, Auth and Access Model,
// Invariants) for the spec this implements.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Root tenant entity. Not itself accountId-scoped.
model Account {
  id        String   @id @default(cuid())
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  AccountUser[]
  stores Store[]
}

enum AccountRole {
  OWNER
}

// Join between an Account and a Clerk-managed user, carrying a role so
// staff roles can be added later without a shape-changing migration
// (context/architecture.md, Auth and Access Model).
model AccountUser {
  id          String      @id @default(cuid())
  accountId   String
  clerkUserId String      @unique
  role        AccountRole @default(OWNER)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Store {
  id            String    @id @default(cuid())
  accountId     String
  shopifyDomain String?   @unique
  // Shop's display name from Shopify (`shop { name }`), or name given by owner
  // when creating store on our side.
  name          String?
  connectedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account  Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  token    ShopifyToken?
  aiRule   StoreAiRule?
  products Product[]
  jobs     Job[]

  @@index([accountId])
}

// Scoped per-store AI generation rules so store owners can customize
// and adapt prompts, voice, title formats, description structure, tags, and constraints.
model StoreAiRule {
  id                 String   @id @default(cuid())
  accountId          String
  storeId            String   @unique
  brandTone          String?  @db.Text
  titleRule          String?  @db.Text
  descriptionRule    String?  @db.Text
  tagsRule           String?  @db.Text
  seoRule            String?  @db.Text
  customInstructions String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// Kept as its own model (not fields on Store) since Shopify OAuth tokens
// are a distinct entity in context/architecture.md's Storage Model table.
model ShopifyToken {
  id                   String   @id @default(cuid())
  accountId            String
  storeId              String   @unique
  apiKeyEncrypted      String?
  apiSecretEncrypted   String?
  accessTokenEncrypted String?
  scope                String?  @default("")
  tokenType            String   @default("bearer")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
}

model Product {
  id               String        @id @default(cuid())
  accountId        String
  storeId          String
  shopifyProductId String?
  title            String
  description      String?       @db.Text
  // Shopify CDN URL, source of truth for published-state images
  // (context/architecture.md Storage Model). Set on import/sync;
  // draft-state Vercel Blob upload is a separate, pre-push concern.
  // Kept as the "primary/featured" image (unchanged usage everywhere it
  // already appears — table thumbnails, dashboard) even now that a product
  // can have more than one image.
  imageUrl         String?
  // Every image Shopify has for this product (including the featured one),
  // read-only display only.
  imageUrls        String[]      @default([])
  price            Decimal       @db.Decimal(10, 2)
  status           ProductStatus @default(DRAFT)
  tags             String[]      @default([])
  collectionId     String?
  // Display name of collectionId's Shopify collection, read-only denormalized
  // copy for the product list's Category column. Reflects the
  // product's existing primary collection from Shopify.
  collectionTitle  String?
  categoryId       String?
  // Shopify's own ready-made breadcrumb string for categoryId (e.g.
  // "Apparel & Accessories > Clothing > Shirts & Tops"), read-only
  // denormalized display copy — same "always write both together" pairing
  // as collectionId/collectionTitle above, just for Shopify's separate
  // standardized Product Taxonomy rather than a merchant-defined collection.
  categoryFullName String?
  seoTitle         String?
  seoDescription   String?

  // Conflict detection (context/architecture.md invariant 6).
  lastEditedAt            DateTime  @default(now())
  lastSyncedAt            DateTime?
  isConflicted            Boolean   @default(false)
  conflictAppSnapshot     Json?
  conflictShopifySnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants Variant[]

  @@unique([storeId, shopifyProductId])
  @@index([accountId])
  @@index([accountId, storeId])
}

model Variant {
  id               String   @id @default(cuid())
  productId        String
  accountId        String
  shopifyVariantId String?
  optionName       String
  price            Decimal  @db.Decimal(10, 2)
  inventory        Int      @default(0)
  // One specific image from the parent product's own gallery
  // (Product.imageUrls), stored the same way every other image reference in
  // this app already is — a plain URL string, not a separate id/media
  // table. Null means this variant has no image of its own and falls back
  // to the product's default gallery display everywhere else in the app.
  imageUrl         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, shopifyVariantId])
  @@index([accountId])
  @@index([productId])
}

enum JobType {
  PUSH
  SYNC
  // A background job for permanently deleting a product from Shopify (not just
  // from Dockit's own database, which lib/db/products.ts's deleteProducts already
  // handles synchronously with no job at all).
  DELETE
  // Background AI image generation pipeline for creating, refining, and generating product variations
  GENERATE_IMAGE
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
}

// One table for all background jobs. `type` is the
// discriminator called for by context/code-standards.md's TypeScript rules.
model Job {
  id          String    @id @default(cuid())
  accountId   String
  storeId     String
  type        JobType
  status      JobStatus @default(PENDING)
  results     Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([accountId, storeId])
}

# Copy to .env and fill in real values. Never commit .env.

# Direct (non-pooled) Neon connection — used by Prisma for schema/migrations.
DATABASE_URL="postgresql://user:password@ep-example-000000.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# Pooled Neon connection (PgBouncer) — reserved for app runtime queries once
# lib/db/ starts querying the database (Unit 5+). Not used by migrations.
DATABASE_URL_POOLED="postgresql://user:password@ep-example-000000-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

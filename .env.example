# Copy to .env and fill in real values. Never commit .env.

# Direct (non-pooled) Neon connection — used by Prisma for schema/migrations.
DATABASE_URL="postgresql://user:password@ep-example-000000.region.aws.neon.tech/dbname?sslmode=verify-full&channel_binding=require"

# Pooled Neon connection (PgBouncer) — reserved for app runtime queries once
# lib/db/ starts querying the database (Unit 5+). Not used by migrations.
DATABASE_URL_POOLED="postgresql://user:password@ep-example-000000-pooler.region.aws.neon.tech/dbname?sslmode=verify-full&channel_binding=require"

# Clerk (set up via `clerk init` — see https://clerk.com/docs/cli)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shopify OAuth (Unit 5) — from a custom app in the Shopify Dev/Partner Dashboard.
SHOPIFY_API_KEY=your_shopify_client_id
SHOPIFY_API_SECRET=your_shopify_client_secret
SHOPIFY_APP_URL=http://localhost:3000
SHOPIFY_SCOPES=read_products,write_products,read_collections
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SHOPIFY_TOKEN_ENCRYPTION_KEY=base64_32_byte_key

# Vercel Blob (Unit 12) — Storage → Create Database → Blob in the Vercel
# dashboard, or `vercel blob store create`. Draft-state product images live
# here until a push replaces them with the Shopify CDN URL.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# AI Models & Generation Providers (Multimodal Vision, Text & Studio Imagery)
# ==============================================================================

# OpenAI API Key — Used by:
# 1. OpenAI Text & Vision Provider (gpt-4o-mini via Vercel AI SDK) for photo inspection,
#    title/description synthesis, and taxonomy mapping.
# 2. Single-product & bulk SEO suggestions and description rewrites.
# 3. OpenAI Image Generator (DALL-E 3) for perspective photography shots.
# Get a key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini API Key — Used by:
# 1. Gemini Multimodal Text & Vision Provider (gemini-3.8-flash) for deep visual analysis,
#    structured catalog field generation, and Shopify taxonomy resolution.
# 2. Gemini Image Generator (gemini-2.5-flash-image) for studio angles and macro shots.
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kie.ai API Key — Used by:
# 1. Kie.ai Image Generator (nano-banana-pro model via task API) for asynchronous,
#    photorealistic commercial product photography from reference images.
# Get a key from Kie.ai developer portal: https://kie.ai
KIE_API_KEY=kie_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
